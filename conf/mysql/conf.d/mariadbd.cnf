[mysqld]
thread_pool_size                = 1      # [计算公式: 等于物理CPU核心数] 线程池分组数，1:1绑定核心可大幅减少系统上下文切换。
aria_pagecache_segment          = 1      # [计算公式: CPU核心数的一半，最高128] 专门用于打散12.3核心系统临时表和向量检索的内存锁。
innodb_read_io_threads          = 4      # [改值规则: 1~2核设4; 4~64核+标准NVMe设8; 128核+多盘RAID设16] 控制后台读盘的线程数。
innodb_write_io_threads         = 4      # [改值规则: 同上] 控制后台刷脏页写盘的线程数。现代Linux有AIO支持，8个线程足以喂饱NVMe，切勿盲目设太大。
innodb_buffer_pool_size         = 2G     # [计算公式: 物理内存的 65% ~ 75%] 核心数据缓存区，留足余量给系统和其他内存表，切勿贴满100%。
aria_pagecache_buffer_size      = 1G     # [计算公式: 物理内存的 3% ~ 5%] 12.3的复杂排序、分组以及向量检索对该内存消耗极大，必须给足。
innodb_log_file_size            = 1G     # [计算公式: innodb_buffer_pool_size 的 25% ~ 30%] 12.3极高写入吞吐需要大Redo Log，防止频繁Checkpoint卡顿。
innodb_io_capacity              = 10000  # [改值规则: 普通SSD设1000~2000; 单块NVMe设10000; 企业级极速阵列卡设30000+]
innodb_io_capacity_max          = 20000  # [计算公式: 通常设置为 innodb_io_capacity 的 2 倍] 允许InnoDB高负载时冲刺使用的最大IOPS限制。


max_connections                 = 1000
skip_name_resolve               = 1        # 禁用DNS反向解析，局域网/本地连接建立速度直接翻倍
thread_handling                 = pool-of-threads
innodb_flush_log_at_trx_commit  = 1        # 严格的事务ACID安全性（双1模式）
sync_binlog                     = 1        # 12.3将binlog移入InnoDB内部，性能暴增，安全与速度兼得
innodb_flush_method             = O_DIRECT # 绕过系统缓存直接读写盘，开启Linux Native AIO的关键
skip-log-bin

# 12.3默认变更为ON。若旧应用未写好乐观锁重试（容易抛1020错误）
innodb_snapshot_isolation       = ON

