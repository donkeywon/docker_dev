[mysqld]
innodb_read_io_threads          = 4       # [改值规则: 1~2核设4; 4~64核设8; 128核+多盘设16]
innodb_write_io_threads         = 4       # [改值规则: 同上]
innodb_buffer_pool_size         = 2G      # [计算公式: 物理内存的 65% ~ 75%]
innodb_buffer_pool_instances    = 1       # [确保每个 instance 分配 2GB，降低内存并发锁竞争]
innodb_log_file_size            = 1G      # [计算公式: innodb_buffer_pool_size 的 25% ~ 30%]
innodb_io_capacity              = 10000   # [改值规则: 普通SSD设1000~2000; 单块NVMe设10000; 企业级设30000+]
innodb_io_capacity_max          = 20000   # [计算公式: 通常设置为 innodb_io_capacity 的 2 倍]

server_id=1

port                            = 3307
skip_name_resolve               = 1        # 禁用DNS反向解析，连接速度翻倍
innodb_flush_method             = O_DIRECT # 绕过系统缓存直接读写盘，开启Linux Native AIO的关键
thread_cache_size               = 64       # 社区版5.7高并发首选：缓存空闲线程，避免频繁创建
skip-log-bin

